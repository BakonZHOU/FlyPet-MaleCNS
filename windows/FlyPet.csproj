<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>FlyPet</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Version>1.1.11</Version><AssemblyVersion>1.1.11.0</AssemblyVersion><FileVersion>1.1.11.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/circuit.json" />
    <EmbeddedResource Include="Assets/Audio/*.wav" />
  </ItemGroup>
</Project>
